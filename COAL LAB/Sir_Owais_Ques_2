INCLUDE Irvine32.inc
.data
    offsetArray    sbyte -5 , 3 , -2 , 7
    readingArray   sbyte lengthof offsetArray DUP(?)
    adjusted       sbyte lengthof offsetArray DUP(?)
    msg1           BYTE "Enter reading ",0
    msg2           BYTE "Adjusted : " , 0
    msg3           BYTE "R (DECIMAL) : " , 0
    msg4           BYTE "R (HEXADECIMAL) : " , 0
    msg5           BYTE "Lower Word Of R : " , 0
    msg6           BYTE "Low Byte Of R : " , 0
    colon BYTE ": ",0
    numR           SDWORD ? 


.code
main PROC
;=============Taking Input=============
    mov esi , offset readingArray
    mov ecx , lengthof offsetArray
    mov eax , 0
    mov ebx , 1
L1 :
    mov edx , offset msg1
    call writestring

    mov eax , ebx
    call writedec

    mov edx , offset colon
    call writestring

    call readint
    mov [esi] , al

    inc esi
    inc ebx
    loop L1

;=============Adjust Readings=============
    mov esi , offset offsetArray
    mov edi , offset readingarray
    mov ebp , offset adjusted
    mov ecx , lengthof offsetArray
L2 :
    movsx eax, BYTE PTR [esi]
    movsx ebx, BYTE PTR [edi]
    add eax, ebx
    mov [ebp] , eax
    
    inc ebp
    inc esi
    inc edi
    loop L2

    mov edx , offset msg2
    call writestring
    
    mov esi , offset adjusted
    mov ecx , lengthof adjusted

L3 :
    movsx eax , BYTE PTR [esi]
    call writeint
    mov al , ' ' 
    call writechar

    inc esi
    loop L3
    call crlf

;============= R = - r0 + ( r1 -  r2 ) + r3 =============
    movsx eax , adjusted[1]
    movsx ebx , adjusted[2]
    sub eax , ebx
    movsx ebx , adjusted[0]
    sub eax , ebx
    movsx ebx , adjusted[3]
    add eax , ebx
    
    mov edx , offset msg3
    call writestring
    call writedec
    call crlf

    mov edx , offset msg4
    call writestring
    call writehex
    call crlf

    mov numR , eax

;============= Low_Word_&_Low_Byte OF NumR =============
    mov edx , offset msg5
    call writestring
    
    mov eax, numR
    movsx eax, ax
    call WriteHex

    call crlf

    mov edx , offset msg6
    call writestring

    mov eax, numR
    movsx eax, al
    call WriteInt
    call crlf

    exit
main ENDP
END main
