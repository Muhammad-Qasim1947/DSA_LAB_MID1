INCLUDE Irvine32.inc


.data
     wordstr byte "ASSEMBLY" , 0 
     codes dword (lengthof wordstr - 1) DUP (?)
     count dword ?
     msg1  byte "Codes : " , 0
     msg2  byte "Sum : " , 0
     

.code
main PROC
;==============Part 1==================
     mov eax , type wordstr
     call writedec
     mov al , ' ' 
     call writechar

     mov eax , lengthof wordstr
     call writedec
     mov al , ' ' 
     call writechar

     mov eax , sizeof wordstr
     call writedec
     mov al , ' ' 
     call writechar

     call crlf

     mov eax , type codes
     call writedec
     mov al , ' ' 
     call writechar

     mov eax , lengthof codes
     call writedec
     mov al , ' ' 
     call writechar

     mov eax , sizeof codes
     call writedec
     mov al , ' ' 
     call writechar
     call crlf
     call crlf

;==============Part 2 Staircase==============

     mov ecx , lengthof wordstr - 1
     mov ebx , 1
outerloop :
     mov esi , offset wordstr
     mov count , ecx
     mov ecx , ebx
innerloop :
     mov al , [esi]
     call writechar
     inc esi
     loop innerloop

     call crlf

     inc ebx
     mov ecx , count
     loop outerloop

;=============Assebly Again Packing============
     mov ecx , lengthof wordstr - 2
     mov ebx , lengthof wordstr - 2
outerloop2 :
     mov esi , offset wordstr
     mov count , ecx
     mov ecx , ebx
innerloop2 :
     mov al , [esi]
     call writechar
     inc esi
     loop innerloop2

     call crlf

     dec ebx
     mov ecx , count
     loop outerloop2
     call crlf

;==============Part 3==============
     mov esi , offset wordstr
     mov edi , offset codes
     mov ecx , lengthof wordstr - 1
L1 :
     movzx eax , byte ptr [esi]
     mov [edi] , eax 
     inc esi
     add edi , type codes
     loop L1

     mov edx , offset msg1
     call writestring

     mov ebx , 0
     mov edi , offset codes         
     mov ecx , lengthof codes     
L2 :
     mov eax , [edi]
     add ebx , eax
     call writedec
     mov al , ' '
     add edi , type codes
     call writechar
     loop L2

     call crlf

     mov edx , offset msg2
     call writestring
     mov eax , ebx
     call writedec
     call crlf
     call crlf

;==============Part 3==============
     
     mov esi , offset wordStr
     mov edx , 0
     mov ecx , lengthof wordStr - 1
L3 :
     add byte ptr[esi] , 'a' - 'A'
     mov al , byte ptr[esi]
     call writechar
     inc esi
     loop L3
     call crlf

    exit
main ENDP
END main
