INCLUDE Irvine32.inc
.data
    arrayoffsets sbyte -5 , 3 , -2 , 7
    readings     sbyte 4 DUP(?)
    adjusted     sbyte 4 DUP(?)
    msg1         byte "Enter Reading : " , 0 
    msg2         byte "Adjusted Readings : " , 0
    msg3         byte "R (decimal) : " , 0
    msg4         byte "R (hexadecimal) : " , 0
    msg5         byte "Low Word Of R : " , 0
    msg6         byte "Low Byte Of R : " , 0
    num          sdword ?

.code
main PROC
;===========Taking Input==========
    mov ecx , lengthof readings
    mov esi , offset readings
L1 :
    mov edx , offset msg1
    call writestring 
    call readint

    mov [esi] , al
    inc esi
    loop L1

;==========Add Offset With Readings========
    mov ecx , lengthof readings
    mov esi , offset readings
    mov edi , offset arrayoffsets
    mov ebp , offset adjusted
L2 :
    mov al , [esi]
    add al , [edi]
    mov byte ptr [ebp] , al
    inc esi 
    inc edi
    inc ebp
    loop L2

    mov edx , offset msg2
    call writestring

    mov ecx , lengthof adjusted
    mov esi , offset adjusted
L3 : 
    movsx eax , byte ptr [esi] 
    call writeint
    mov al , ' '
    call writechar
    inc esi
    loop L3

;========= Calculating R ========
    mov esi , offset adjusted
    movsx eax , byte ptr [esi]                         ; r0
    neg eax                                            ; -r0
    movsx ebx , byte ptr [esi + type adjusted]         ; r1
    movsx edx , byte ptr [esi + type adjusted * 2]     ; r2
    sub ebx , edx                                      ; (r1 - r2)
    add eax , ebx                                      ; -r0 + (r1 - r2)
    movsx ebx , byte ptr [esi + type adjusted * 3]     ; r3
    add eax , ebx                                      ; + r3
    mov num , eax
    
    call crlf
    mov edx , offset msg3
    call writestring 
    call writedec

    call crlf
    mov edx , offset msg4
    call writestring
    call writehex

;============Lower Word And Byte Of R===========
    call crlf

    mov edx , offset msg5
    call writestring
    
    mov eax, num
    movzx eax, ax
    mov ebx , type word
    call WriteHexB

    call crlf
    mov edx , offset msg6
    call writestring

    mov eax , num
    movsx eax , al         
    call Writeint

    exit
main ENDP
END main
