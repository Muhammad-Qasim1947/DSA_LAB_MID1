;Using the constant ROWS = 5 and two nested LOOP instructions, print the 
;number triangle shown below. Row n contains the numbers 1 to n separated 
;by spaces. Save the outer loop counter in a DWORD variable before the 
;inner loop and restore it before the outer LOOP, as shown in the lab 
;manual. Because WriteChar overwrites AL, keep the number being printed 
;in a register other than EAX. In a comment, state how many times the 
;inner loop body executes in total.

INCLUDE Irvine32.inc

rows = 5
.data
    count DWORD ?

.code
main PROC
    mov ecx , rows 
    mov ebx , 1
outer :
    mov count , ecx 
    mov ecx , ebx
    mov eax , 1
inner :
    call writedec
    inc eax 
    loop inner
    call crlf

    mov ecx , count
    inc ebx
    loop outer
    call crlf
    
    exit
main ENDP
END main
