INCLUDE Irvine32.inc
.data
    wordStr  BYTE "ASSEMBLY",0
    codes    DWORD (LENGTHOF wordStr - 1) DUP(?)  
    hdr      BYTE "Array properties   ElementSize  ElementCount  TotalSize",0
    lblW     BYTE "wordStr            ",0
    lblC     BYTE "Codes              ",0
    space    BYTE "            ",0
    addition      BYTE "Sum : " , 0   
    msg1     BYTE "Staircase",0
    count    DWORD ?
    msg2     BYTE "Lower Case : " , 0 

.code
main PROC
;===================Part A===================
     mov edx , offset hdr
     call writestring
     call crlf
     mov edx , offset lblW
     call writestring 
     mov eax , type wordStr
     call writedec
     mov edx, OFFSET space
     call WriteString
     mov eax , lengthof wordStr
     call writedec
     mov edx, OFFSET space
     call WriteString
     mov eax , sizeof wordStr
     call writedec
     call crlf

     mov edx , offset lblC
     call writestring 
     mov eax , type codes
     call writedec
     mov edx, OFFSET space
     call WriteString
     mov eax , lengthof codes
     call writedec
     mov edx, OFFSET space
     call WriteString
     mov eax , sizeof codes
     call writedec
     call crlf
     call crlf

;===================Part C===================
     mov edx, OFFSET msg1
     call WriteString
     call Crlf
     
     mov ebx , 1
     mov ecx , lengthof wordStr - 1
outer :
     mov count , ecx
     mov esi , offset wordStr
     mov ecx , ebx
inner :
     mov al , [esi]
     call writechar
     inc esi
     loop inner

     call crlf

     inc ebx
     mov ecx , count
     loop outer
     call crlf

;===================Part C===================
     mov esi , offset wordStr
     mov edi , offset codes
     mov ecx , lengthof wordStr - 1
L1 :
     movzx eax , byte ptr [esi]
     mov [edi] , eax
     inc esi
     add edi , 4
     loop L1

     mov edi , offset codes
     mov ecx , lengthof codes
     mov ebx , 0
L2 : 
     add ebx , [edi]
     add edi , 4
     loop L2

     mov edx , offset lblC
     call writestring 
     call crlf

     mov esi , offset codes
     mov ecx , lengthof codes

L3 :
     mov eax , [esi]
     add esi , 4
     call writedec
     mov al , ' '
     call writechar
     loop L3
     call crlf

     call crlf
     mov edx , offset addition
     mov eax , ebx
     call writestring
     call writedec
     call crlf

;===================Part D===================
     mov esi , offset codes
     mov ecx , lengthof wordStr - 1

L4 :
     add dword ptr[esi] , 32
     add esi , 4
     loop L4

     call crlf
     mov edx , offset msg2
     call writestring 

     mov esi, OFFSET codes
     mov ecx, LENGTHOF codes

L5:
    mov eax, [esi]
    call WriteChar
    add esi, 4
    loop L5

    exit
main ENDP
END main
